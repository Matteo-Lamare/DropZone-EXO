# PostgreSQL credentials used by the db service.
POSTGRES_DB=dropzone
POSTGRES_USER=dropzone
POSTGRES_PASSWORD=dropzone_dev_password

# SQLAlchemy URL used by the API. Use the Compose service name "db", not localhost.
DATABASE_URL=postgresql+psycopg://dropzone:dropzone_dev_password@db:5432/dropzone

# API configuration.
LOG_LEVEL=INFO
SEED_DEMO_DATA=true
